# Public client config. Copy to .env.local and fill from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth client. Used by Supabase Auth, not by the Next.js app directly.
# Leave blank until you create the client. See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay test mode. Leave blank to use the local subscription simulator.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PRO=
